# OPENAI_API_KEY: Required for OpenAI API calls (gpt-4o-mini, gpt-4o)
# Get yours from https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 calls.
# Retrieve from Google Cloud Console (https://console.cloud.google.com)
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
