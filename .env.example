# OPENAI_API_KEY: Required for OpenAI API calls (gpt-4o-mini, gpt-4o)
# Get yours from https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 calls.
# Retrieve from Google Cloud Console (https://console.cloud.google.com)
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── 크로스세션 저장 (P-11) — 선택 ──────────────────────────────────────────
# 미설정 시 로컬 파일(.data/sessions.json)로 자동 폴백하므로 없어도 동작한다.
# SUPABASE_URL: 프로젝트 URL (예: https://xxxx.supabase.co)
# SUPABASE_SERVICE_KEY: service_role 키 (서버에서만 사용, 브라우저에 노출 금지)
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_SERVICE_KEY="MY_SUPABASE_SERVICE_KEY"

# 참여자 닉네임 해시용 salt (D-8). 바뀌면 단골 인식이 초기화되므로 고정 유지.
SESSION_HASH_SALT="change-me-to-a-long-random-string"

# 회차 보존기간(일). 기본 90일. 초과분은 저장 시점에 정리된다 (D-8).
SESSION_RETENTION_DAYS="90"
