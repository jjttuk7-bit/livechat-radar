  "messages": [
    { "id": "q1", "author": "시청자1", "message": "이 현안 언제부터 시작된 건가요?", "timestamp": "2026-08-12T10:00:00.000Z" },
    { "id": "q2", "author": "시청자2", "message": "근거 자료 좀 올려주세요", "timestamp": "2026-08-12T10:00:04.000Z" },
    { "id": "q3", "author": "시청자3", "message": "쉽게 설명해주세요 이해가 안 됩니다", "timestamp": "2026-08-12T10:00:08.000Z" },
    { "id": "q4", "author": "시청자4", "message": "이 부분 어떻게 생각하시나요?", "timestamp": "2026-08-12T10:00:12.000Z" },
    { "id": "q5", "author": "시청자5", "message": "기자님, 이 대목 확인 부탁드립니다", "timestamp": "2026-08-12T10:00:16.000Z" },
    { "id": "q6", "author": "시청자6", "message": "다시보기 몇 분부터 보면 되나요", "timestamp": "2026-08-12T10:00:20.000Z" },
    { "id": "q7", "author": "시청자7", "message": "우리가 뭘 해야 하나요?", "timestamp": "2026-08-12T10:00:24.000Z" },
    { "id": "q8", "author": "시청자8", "message": "이 주제 다뤄주세요", "timestamp": "2026-08-12T10:00:28.000Z" },
    { "id": "q9", "author": "시청자9", "message": "맞습니다 동감입니다", "timestamp": "2026-08-12T10:00:32.000Z" },
